{
  "schemaVersion": 1,
  "id": "mithrilpf",
  "version": "${version}",
  "name": "MithrilPF",
  "description": "Dungeon party finder client. In development.",
  "authors": ["mithril"],
  "contact": {
    "homepage": "https://mithril.foo/party-finder",
    "sources": "https://github.com/MithrilAddons/mithrilpf"
  },
  "license": "All-Rights-Reserved",
  "environment": "client",
  "mixins": ["mithrilpf.mixins.json"],
  "entrypoints": {
    "client": [{"adapter": "kotlin", "value": "dev.mithril.mithrilpf.MithrilPF"}],
    "modmenu": [{"adapter": "kotlin", "value": "dev.mithril.mithrilpf.compat.ModMenuIntegration"}]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.1.2",
    "java": ">=25",
    "fabric-api": ">=0.154.2+26.1.2",
    "fabric-language-kotlin": ">=1.13.12+kotlin.2.4.0"
  },
  "suggests": {"modmenu": "*"}
}
